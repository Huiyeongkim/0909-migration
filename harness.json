      "allowedPaths": [
        "commerce-rs/**",
        "migration-spec/contracts/product-get-detail.md",
        "migration-spec/anomalies/product-get-detail.md",
        "migration-spec/plan.json"
      ],
      "forbiddenPaths": ["legacy/**"],
      "setup": [],
      "verification": [
        {
          "id": "legacy-product-tests",
          "command": [
            "./gradlew",
            "-p",
            "commerce",
            "test",
            "--tests",
            "store._0982.commerce.application.product.ProductServiceTest",
            "--tests",
            "store._0982.commerce.presentation.product.ProductControllerTest"
          ],
          "cwd": "legacy"
        }
      ],
      "doneWhen": [
        {
          "id": "legacy-contract",
          "description": "레거시 HTTP 및 오류 동작이 계약 문서에 기록되어 있다."
        },
        {
          "id": "lookup-tests",
