{
  "version": 1,
  "integrationBranch": "main",
  "branchPrefix": "codex/",
  "worktreeRoot": "../0909-migration-worktrees",
  "remote": "origin",
  "maxParallel": 3,
  "protectedBranches": ["main", "dev"],
  "defaultSetup": [
    {
      "id": "clone-legacy-source",
      "command": [
        "git",
        "clone",
        "--depth",
        "1",
        "https://github.com/Huiyeongkim/0909.git",
        "legacy"
      ],
      "cwd": "."
    }
  ],
  "defaultVerification": [
    {
      "id": "rust-format",
      "command": ["cargo", "fmt", "--check"],
      "cwd": "commerce-rs"
    },
    {
      "id": "rust-check",
      "command": ["cargo", "check"],
      "cwd": "commerce-rs"
    },
    {
      "id": "rust-clippy",
      "command": ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"],
      "cwd": "commerce-rs"
    },
    {
      "id": "rust-test",
      "command": ["cargo", "test"],
      "cwd": "commerce-rs"
    },
    {
      "id": "migration-plan-json",
      "command": ["python3", "-m", "json.tool", "migration-spec/plan.json"],
      "cwd": "."
    }
  ],
  "tasks": [
    {
      "id": "product-get-detail",
      "title": "상품 상세 조회 마이그레이션",
